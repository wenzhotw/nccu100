    {
      "id": "principal",
      "tag": "校長　李蔡彥",
      "title": "校長．李蔡彥",
      "indoor": true,
      "home": {
        "x": "IX",
        "z": -12.5
      },
      "face": 0,
      "look": {
        "top": "#26304f",
        "pants": "#1f2433",
        "suit": true,
        "tie": "#6b3f8f",
        "pin": true,
        "hair": "#a3a7ab",
        "brow": "#6d6f72",
        "hairStyle": "side",
        "glasses": "#b9bdc3",
        "shoe": "#1c1c20"
      },
      "dialog": [
        {
          "when": {
            "haveMap": false
          },
          "lines": [
            "你好，我是政大校長李蔡彥。",
            "明年就是政大創校一百週年了。",
            "我想請你幫個忙：走遍校園，收集大家的校園故事。",
            "把故事收集齊全，就能找到政大的百年寶藏。",
            "這張「百年秘寶地圖」交給你，上面標出了故事可能藏著的地方。按 M 就能打開。"
          ],
          "then": "giveMap"
        },
        {
          "when": {
            "found": {
              "lt": "total"
            }
          },
          "lines": [
            "目前收集到 {found} 個校園故事，還差 {left} 個。",
            "打開百年秘寶地圖看看，還有哪裡沒去過。"
          ]
        },
        {
          "lines": [
            "三個校園故事都收集齊了，真了不起！",
            "百年寶藏的線索，就藏在這些故事裡。謝謝你為政大的一百年留下紀錄。"
          ]
        }
      ]
    },
