{
  "name": "nccu100",
  "private": true,
  "version": "1.81.0",
  "type": "module",
  "description": "蓋亞造界．政大百年慶版：政大山下校園 3D 冒險遊戲",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs && node scripts/baozhong-smoke.mjs",
    "new-building": "node scripts/new-building.mjs",
    "new-interior": "node scripts/new-interior.mjs",
    "test": "node --test scripts/*.test.mjs && npm run test:baozhong && npm run test:npc-costumes && npm run test:characters && npm run test:stage2",
    "test:baozhong": "sh tests/run-portable.sh",
    "test:npc-costumes": "node --test tests/npc-costumes.test.mjs",
    "test:characters": "node --import ./tests/characters/register.mjs --test tests/characters/snapshot.test.mjs",
    "test:stage2": "node --test tests/bz26-stage2.test.mjs tests/bz26-radio.test.mjs tests/bz26-programs.test.mjs src/systems/baozhong/matching.test.js"
  },
  "dependencies": {
    "three": "0.149.0"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "vite": "^5.4.0"
  }
}
